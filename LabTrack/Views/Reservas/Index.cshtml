@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Mis reservas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mis reservas</h1>
    <a asp-action="Create" class="btn btn-primary" id="btn-nueva-reserva">+ Nueva reserva</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" id="mensaje-sin-reservas">Aún no ha registrado reservas.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="tabla-mis-reservas">
                <thead class="table-light">
                    <tr><th>#</th><th>Equipo</th><th>Fecha</th><th>Horario</th><th>Estado</th><th>Observación</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr data-reserva-id="@r.Id">
                            <td>@r.Id</td>
                            <td>@r.Equipo!.CodigoInventario - @r.Equipo.Nombre</td>
                            <td>@r.Inicio.ToString("dd/MM/yyyy")</td>
                            <td>@r.Inicio.ToString("HH:mm") - @r.Fin.ToString("HH:mm")</td>
                            <td><partial name="_EstadoReserva" model="r.Estado" /></td>
                            <td class="small">
                                @if (r.Estado == EstadoReserva.Rechazada)
                                {
                                    <span class="text-danger">@r.MotivoRechazo</span>
                                }
                                else if (r.DevueltaConRetraso)
                                {
                                    <span class="text-danger">Devuelto con retraso</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                @if (r.Estado == EstadoReserva.Pendiente)
                                {
                                    <form asp-action="Cancelar" asp-route-id="@r.Id" method="post" class="d-inline"
                                          data-confirmar="¿Desea cancelar esta reserva?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-cancelar">Cancelar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
