@model CatalogoViewModel
@{
    var esEncargado = User.IsInRole(nameof(RolUsuario.Encargado));
    var esEstudiante = User.IsInRole(nameof(RolUsuario.Estudiante));
    ViewData["Title"] = esEncargado ? "Equipos" : "Catálogo de equipos";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    @if (esEncargado)
    {
        <a asp-action="Create" class="btn btn-primary" id="btn-nuevo-equipo">+ Nuevo equipo</a>
    }
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3" id="filtros-categoria">
            <a asp-action="Index" id="filtro-todas"
               class="btn btn-sm @(Model.CategoriaId == null ? "btn-primary" : "btn-outline-primary")">Todas</a>
            @foreach (var c in Model.Categorias)
            {
                <a asp-action="Index" asp-route-categoriaId="@c.Id" data-categoria="@c.Nombre"
                   class="btn btn-sm filtro-categoria @(Model.CategoriaId == c.Id ? "btn-primary" : "btn-outline-primary")">@c.Nombre</a>
            }
        </div>
        <form method="get" asp-action="Index" class="row g-2">
            @if (Model.CategoriaId.HasValue)
            {
                <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
            }
            <div class="col-sm-8 col-md-6">
                <input type="search" name="busqueda" value="@Model.Busqueda" class="form-control" id="busqueda-equipo"
                       placeholder="Buscar por nombre o código de inventario" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary" id="btn-buscar-equipo">Buscar</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Equipos.Any())
{
    <div class="alert alert-info" id="mensaje-sin-equipos">No hay equipos disponibles en esta categoría</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="tabla-equipos">
                <thead class="table-light">
                    <tr>
                        <th>Código de inventario</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Equipos)
                    {
                        <tr data-equipo-id="@e.Id">
                            <td class="fw-semibold">@e.CodigoInventario</td>
                            <td>@e.Nombre</td>
                            <td>@e.Categoria?.Nombre</td>
                            <td>@e.Ubicacion</td>
                            <td><partial name="_EstadoEquipo" model="e.Estado" /></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                @if (esEstudiante && e.Estado == EstadoEquipo.Disponible)
                                {
                                    <a asp-controller="Reservas" asp-action="Create" asp-route-equipoId="@e.Id" class="btn btn-sm btn-primary btn-reservar">Reservar</a>
                                }
                                @if (esEncargado)
                                {
                                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">@Model.Equipos.Count equipo(s) encontrado(s)@(Model.CategoriaSeleccionada is null ? "" : $" en {Model.CategoriaSeleccionada}").</p>
}
