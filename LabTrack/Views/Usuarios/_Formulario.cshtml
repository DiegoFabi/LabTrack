@model UsuarioFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" placeholder="Ej. N00045678" />
        <span asp-validation-for="Codigo" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        @if (Model.Id != 0)
        {
            <div class="form-text">Déjelo en blanco para conservar la contraseña actual.</div>
        }
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" asp-items="Html.GetEnumSelectList<RolUsuario>()" class="form-select"></select>
        <span asp-validation-for="Rol" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoUsuario>()" class="form-select"></select>
    </div>
</div>
