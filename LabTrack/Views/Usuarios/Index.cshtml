@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var ahora = (DateTime)ViewBag.Ahora;
    var rolSel = ViewBag.Rol as RolUsuario?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary" id="btn-nuevo-usuario">+ Nuevo usuario</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por código o nombre" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select name="rol" class="form-select">
            <option value="">Todos los roles</option>
            @foreach (var r in Enum.GetValues<RolUsuario>())
            {
                <option value="@r" selected="@(rolSel == r)">@r</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Filtrar</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="tabla-usuarios">
            <thead class="table-light">
                <tr><th>Código</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Acceso</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var bloqueado = u.EstaBloqueado(ahora);
                    <tr>
                        <td class="fw-semibold">@u.Codigo</td>
                        <td>@u.NombreCompleto<div class="small text-muted">@u.Email</div></td>
                        <td>@u.Rol</td>
                        <td><span class="badge @u.Estado.CssBadge()">@u.Estado</span></td>
                        <td>
                            @if (bloqueado)
                            {
                                <span class="badge bg-warning text-dark">Bloqueado hasta @u.BloqueadoHasta!.Value.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted small">Normal</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (bloqueado)
                            {
                                <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-warning" type="submit">Desbloquear</button>
                                </form>
                            }
                            @if (u.Estado == EstadoUsuario.Penalizado)
                            {
                                <form asp-action="QuitarPenalizacion" asp-route-id="@u.Id" method="post" class="d-inline"
                                      data-confirmar="¿Retirar la penalización de @u.NombreCompleto?">
                                    <button class="btn btn-sm btn-success" type="submit">Quitar penalización</button>
                                </form>
                            }
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
