@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorías</h1>
    <a asp-action="Create" class="btn btn-primary" id="btn-nueva-categoria">+ Nueva categoría</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="tabla-categorias">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Descripción</th><th class="text-center">Equipos</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nombre</td>
                        <td>@c.Descripcion</td>
                        <td class="text-center">@c.Equipos.Count</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Equipos" asp-action="Index" asp-route-categoriaId="@c.Id" class="btn btn-sm btn-outline-secondary">Ver equipos</a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
