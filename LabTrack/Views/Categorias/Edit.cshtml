@model Categoria
@{
    ViewData["Title"] = "Editar categoría";
}
<h1 class="h3 mb-3">Editar categoría</h1>
<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Edit" method="post" id="form-categoria">
            <input type="hidden" asp-for="Id" />
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary" id="btn-guardar">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
